1,\"ئافەرم! بەشێکی پردەکەت تەواو کرد. بۆ ئەرکی دواتر دەست لە دوگمە گەورەکە بدە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئەمە باغەکەتە. گوڵەکان یادگاریی گەشتە تەواوکراوەکانتن. پیتی کراوەکە هەڵبژێرە. بە تەواوکردنی ئەو گەشتە، پیتی دواتر دەکرێتەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"با دووبارە دەست پێ بکەین. گوێ لە ڕێنماییەکە بگرە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئەمە باخچەی پەپوولەکانتە. لێرە هاوڕێکەت هەیە. شەهدی بدەرێ تا گەورە ببێت. هەر کاتێک شتێکی نوێ فێر بیت، پەپوولەیەکی نوێ دەکرێتەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئەمە یاری وشە و وێنەیە. یەکێک لە بەشەکان هەڵبژێرە: ئاژەڵ، خواردن، میوە، یان ڕستە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"سەیری وێنەکە بکە و وشەی دروست هەڵبژێرە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ڕستەکە ببیستە و وێنەی دروست هەڵبژێرە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئەمە ماجەرایەکانی پەپوولەیە. ماجەرایەک هەڵبژێرە و یارمەتی پەپوولە بدە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"گوێ بگرە و وێنەی دروست هەڵبژێرە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"نزیک بوویت. دووبارە هەوڵ بدە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"پەپوولە زۆر برسییەتی! یارمەتی بدە خواردنەکانی بدۆزێتەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئافەرین! پەپوولە ئێستا تێر بوو و زۆر دڵخۆشە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئاژەڵەکانی باخچە خۆیان شاردووەتەوە! یارمەتی بدە بیاندۆزینەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئافەرین! هەموو ئاژەڵەکانت دۆزییەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"با میوە و سەوزەکان کۆ بکەینەوە بۆ سەبەتەکە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئافەرین! سەبەتەکە پڕ بوو.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئەمە گەشتی گەورەیە! هەموو شتەکان بدۆزەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"پیرۆزە! تۆ پالەوانی ماجەرایەکانی.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]"]}