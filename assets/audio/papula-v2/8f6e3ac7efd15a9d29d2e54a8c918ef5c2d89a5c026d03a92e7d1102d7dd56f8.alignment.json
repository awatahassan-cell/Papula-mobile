]","[1,\"با وشەکە دروست بکەین! لە ڕاستەوە دەست پێ بکە. دەست لە پیتەکان بدە و بە ڕیز دایانبنێ.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"بە پەنجەت بەسەر پیتی خۆڵەمێشییەکەدا بڕۆ. لە خاڵە سەوزەکە دەست پێ بکە. خاڵەکانی پیتەکەش لەبیر نەکە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"پردەکەت تەواو کرد! ئێستا با چیرۆکی ئەم پیتە ببیستین. دەست لە دوگمەی کتێبەکە بدە. دوای چیرۆکەکە دەگەڕێینەوە بۆ باغەکەت.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئەم گەشتە هێشتا داخراوە. با سەرەتا گەشتی ئێستامان تەواو بکەین، پاشان ئەمە دەکرێتەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئافەرم! گوڵەکەت ئامادەیە. دەست لە دوگمەی چاندنی گوڵەکەت بدە، تا لە تەنیشت گوڵەکانی ترت بڕوێت.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئەم گوڵە یادگاریی هەوڵی تۆیە. ئێستا با پشوو بدەین.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"نزیک بوویت! با پێکەوە جارێکی تر تاقی بکەینەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئافەرم! بەشێکی پردەکەت تەواو کرد. بۆ ئەرکی دواتر دەست لە دوگمە گەورەکە بدە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"ئەمە باغەکەتە. گوڵەکان یادگاریی گەشتە تەواوکراوەکانتن. پیتی کراوەکە هەڵبژێرە. بە تەواوکردنی ئەو گەشتە، پیتی دواتر دەکرێتەوە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]","[1,\"با دووبارە دەست پێ بکەین. گوێ لە ڕێنماییەکە بگرە.\",\"tkI70vi7ETrk5NakcLUP\",\"eleven_v4\"]"]}